# === Supabase (wajib) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Local PostgreSQL Analytics DB (wajib) ===
# Dashboard uses connection string:
# Dari host (localhost):
ANALYTICS_DATABASE_URL=postgresql://analytics_user:password@localhost:5433/analytics_db
# Docker Compose uses these individual vars:
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=analytics_db
LOCAL_DB_USER=analytics_user
LOCAL_DB_PASSWORD=analytics_dev_password
#
# NOTE: Port 5433 adalah host port (localhost). Di dalam container Docker,
# internal network tetap menggunakan postgres:5432. Jika menjalankan
# aplikasi langsung di host (tanpa Docker), gunakan port 5432.
# Contoh koneksi dari dalam container:
# ANALYTICS_DATABASE_URL=postgresql://analytics_user:password@postgres:5432/analytics_db

# === AI / Chat (opsional) ===
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_ENCRYPTION_KEY=

# === Deployment (opsional, dengan default) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
DASHBOARD_PORT=3031

# === Sync Worker (opsional, dengan default) ===
SYNC_WORKER_PORT=3032
SYNC_INTERVAL_MS=300000
SYNC_BATCH_SIZE=500
SYNC_LOOKBACK_DAYS=365
