# Supabase Configuration
# Copy this file to .env or .env.local and fill in your actual values

# Public environment variables (safe to expose to browser)
# These are used in client-side code and will be bundled with your application
# Use VITE_ prefix for Vite projects or NEXT_PUBLIC_ for Next.js projects
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Alternative Next.js style variables (optional, if using Next.js)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only environment variables (NEVER expose to browser)
# This key has elevated privileges and should only be used in server-side code
# NEVER use this key in client components or expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration (optional)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Configuration (optional - can also be set via UI in Analytics AI page)
# If set here, AI will work without needing to configure in browser
# Supported providers: openai, anthropic, deepseek, openai-compatible
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1/chat/completions  # Only for openai-compatible

# AI Config Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ─── Local PostgreSQL Analytics DB ───
LOCAL_DB_NAME=kr_analytics
LOCAL_DB_USER=analytics
LOCAL_DB_PASSWORD=analytics_dev_password
LOCAL_DB_PORT=5433

# ─── Sync Worker ───
SYNC_INTERVAL_MS=300000
SYNC_BATCH_SIZE=1000
SYNC_LOOKBACK_DAYS=30

# ─── App ───
APP_PORT=3031
