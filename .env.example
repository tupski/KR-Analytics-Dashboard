# Supabase Configuration
# Copy this file to .env or .env.local and fill in your actual values

# Public environment variables (safe to expose to browser)
# These are used in client-side code and will be bundled with your application
# Use VITE_ prefix for Vite projects or NEXT_PUBLIC_ for Next.js projects
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key

# Alternative Next.js style variables (optional, if using Next.js)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only environment variables (NEVER expose to browser)
# This key has elevated privileges and should only be used in server-side code
# NEVER use this key in client components or expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration (optional)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
